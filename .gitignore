# macOS Finder metadata
.DS_Store
__pycache__/

# RStudio session state and local R workspace files.
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# Keep Grimmer 2022 book and chapter PDFs local (copyright).
[Gg]rimmer*2022*.[Pp][Dd][Ff]

# Keep slide sources private by default; publish HTML and PDF outputs.
**/slide/**
!**/slide/*.[Hh][Tt][Mm][Ll]
!**/slide/*.[Pp][Dd][Ff]

# Reviewed student sources without presenter notes.
!Ｗ1/slide/week1.qmd
!W2/slide/week2.qmd
!W10/slide/liao-tang-case.qmd

# Keep full W10 readings and local production scripts private.
W10/papers/*.pdf
W10/scripts/

# Retain the Week 1 R Markdown source locally only.
Ｗ1/slide/week1.Rmd

# Keep the existing local-only lecture build tools private after relocation.
W2/scripts/
Ｗ1/scripts/

# Presenter sources and builds stay local.
**/slide/*-presenter.[Qq][Mm][Dd]
**/slide/*-presenter.[Hh][Tt][Mm][Ll]
